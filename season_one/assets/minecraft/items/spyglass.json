{
  "model": {
    "type": "minecraft:condition",
    "property": "minecraft:using_item",
    "on_true": {
      "type": "minecraft:range_dispatch",
      "property": "minecraft:custom_model_data",
      "entries": [
        {
          "threshold": 101,
          "model": {
            "type": "minecraft:model",
            "model": "wyrd_model:item/lewis/magnifying_glass_in_hand/magnifying_glass_in_hand"
          }
        }
      ],
      "fallback": {
        "type": "minecraft:model",
        "model": "minecraft:item/spyglass_in_hand"
      }
    },
    "on_false": {
      "type": "minecraft:range_dispatch",
      "property": "minecraft:custom_model_data",
      "entries": [
        {
          "threshold": 100,
          "model": {
            "type": "minecraft:model",
            "model": "wyrd_model:item/lewis/magnifying_glass/magnifying_glass"
          }
        }
      ],
      "fallback": {
        "type": "minecraft:model",
        "model": "minecraft:item/spyglass"
      }
    }
  },
  "hand_animation_on_swap": false,
  "oversized_in_gui": false
}